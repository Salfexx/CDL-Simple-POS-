// Prisma schema for Simple POS (Point of Sale)
// Cambodia Digital Literacy (CDL) Final Project

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("CASHIER") // ADMIN or CASHIER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  barcode     String?     @unique
  price       Decimal     @db.Decimal(10, 2)
  cost        Decimal     @default(0.00) @db.Decimal(10, 2)
  stock       Int         @default(0)
  minStock    Int         @default(5)
  imageUrl    String?
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  saleItems   SaleItem[]
}

model Sale {
  id             String      @id @default(cuid())
  invoiceNumber  String      @unique
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  totalAmount    Decimal     @db.Decimal(10, 2)
  receivedAmount Decimal     @db.Decimal(10, 2)
  changeAmount   Decimal     @default(0.00) @db.Decimal(10, 2)
  paymentMethod  String      @default("CASH") // CASH, KHQR, CARD
  status         String      @default("COMPLETED")
  notes          String?
  createdAt      DateTime    @default(now())
  items          SaleItem[]
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  subtotal  Decimal  @db.Decimal(10, 2)
}
